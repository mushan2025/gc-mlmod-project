# Large/raw data and regenerated analysis artifacts.
data/public_downloads/**
data/processed_input/**
objects/**
tmp/**
server_downloads/**
!data/public_downloads/.gitkeep
!data/processed_input/.gitkeep
!objects/.gitkeep
!tmp/.gitkeep

# Large binary analysis outputs.
*.rds
*.RDS
*.rdata
*.RData
*.h5ad
*.loom
*.feather
*.tar
*.gz
*.zip

# Figure and reference binaries are stored locally, not versioned by git.
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.pdf
*.docx

# Runtime/editor noise.
.Rhistory
.RData
__pycache__/
.ipynb_checkpoints/
.DS_Store
Thumbs.db

# Local F1 runtime records retained through the artifact manifest.
logs/F1_single_cell/**
!logs/F1_single_cell/.gitkeep
results/F1_qc/qc_cell_decision_audit.tsv
results/F1_qc/doublet_summary_failed_*.tsv
results/F1_qc/ambient_rna_cell_estimates.tsv
results/F1_qc/broad_lineage_invalid_diagnostic_*/
SOURCE_COMMIT.txt
